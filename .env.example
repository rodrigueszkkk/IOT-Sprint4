# Copie este arquivo para .env e preencha os valores. O .env não deve ser versionado.

# Chave gratuita da API do Google AI Studio (Gemini): https://aistudio.google.com/apikey
# Obrigatória para subir a aplicação no modo padrão.
GEMINI_API_KEY=

# gemini (padrão, usa a chave acima) | offline (sem IA online, apenas para testes)
CLYVO_LLM_PROVIDER=gemini

# Modelo do Gemini usado pelo copiloto e pelo assistente (disponível no plano gratuito)
CLYVO_LLM_MODEL=gemini-flash-latest

# Minutos sem repetir alerta do mesmo nível para o mesmo pet (exceto se o quadro piorar ou houver SOS)
CLYVO_ALERT_COOLDOWN_MIN=5
